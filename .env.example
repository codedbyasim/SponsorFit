# Names only. Never commit real values.

# Qloo hackathon key. Sent only as the X-Api-Key header from the server.
QLOO_API_KEY=
# Optional. Defaults to the hackathon host.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# AIML API (OpenAI-compatible). Used only to phrase pitches from returned evidence.
AIML_API_KEY=
# Optional overrides.
AIML_MODEL=gpt-4o-mini
AIML_BASE_URL=https://api.aimlapi.com/v1
